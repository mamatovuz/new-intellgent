PORT=4000
JWT_SECRET=change_me_to_a_strong_secret
WEB_URL=http://localhost:5173
# Database auto-detect priority:
# 1) DATABASE_URL
# 2) MONGODB_URI
# 3) POSTGRES_URL
# 4) MYSQL_URL
# 5) sqlite fallback when no URL is provided

# MongoDB Atlas:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/ilmnest?appName=ILM-NEST

# Supabase/Postgres:
# DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:6543/postgres

# Optional explicit URLs if you do not want to use DATABASE_URL:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ilmnest?appName=ILM-NEST
# POSTGRES_URL=postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:6543/postgres
# MYSQL_URL=mysql://user:password@host:3306/database

MONGODB_DB_NAME=ilmnest
# DB_PROVIDER is optional. Leave it empty for automatic detection.
# DB_PROVIDER=mongodb

BOT_ENABLED=true

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=@your_bot_username
